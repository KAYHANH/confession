# ==============================================================================
# ConfessionFlow Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock Mode (Set to true to develop & test without real Google/Instagram/Groq keys)
MOCK_EXTERNAL_APIS=true

# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration (Groq AI / OpenAI)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback/Alternative AI Provider
OPENAI_API_KEY=
AI_API_KEY=

# Google Sheets Integration (Service Account)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Form Responses 1
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Meta / Instagram Graph API Configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_user_or_page_access_token

# Cron Security (Protects /api/cron/* endpoints)
CRON_SECRET=confessionflow_cron_secret_key_change_in_production

# Publishing Guardrails & Preferences
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_DAILY_POSTS=10
AUTO_PUBLISH_ENABLED=false
BRAND_NAME=ConfessionFlow
INSTAGRAM_HANDLE=@yourconfessionspage
